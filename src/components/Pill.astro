---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border border-[var(--color-line)] bg-[var(--color-paper)] px-3 py-1 text-xs font-medium text-[var(--color-ink-soft)] dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark)] dark:text-[var(--color-ink-dark-soft)]',
    className,
  ]}
>
  <slot />
</span>
