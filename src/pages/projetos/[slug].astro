---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { projects } from '../../data/projects';
import overview from '../../assets/diagrams/6c-overview.png';
import caseSmartprod from '../../assets/diagrams/case-smartprod.png';
import vitaLogo from '../../assets/diagrams/vita-logo.webp';
import liaAvatar from '../../assets/diagrams/lia-avatar.webp';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const diagramMap: Record<string, ImageMetadata> = {
  '6c-overview.png': overview,
  'case-smartprod.png': caseSmartprod,
  'vita-logo.webp': vitaLogo,
  'lia-avatar.webp': liaAvatar,
};

const { project } = Astro.props;
const lang = 'pt' as const;
const t = useTranslations(lang);

const sections: { heading: string; body: string }[] = [
  project.challenge && { heading: 'O desafio', body: project.challenge.pt },
  project.solution && { heading: 'A solução', body: project.solution.pt },
  project.methodology && { heading: 'Metodologia', body: project.methodology.pt },
  project.architecture && { heading: 'Arquitetura', body: project.architecture.pt },
  ...(project.extraSections ?? []).map((s) => ({ heading: s.heading.pt, body: s.body.pt })),
].filter(Boolean) as { heading: string; body: string }[];
---

<BaseLayout
  lang={lang}
  title={project.title.pt}
  description={project.subtitle.pt}
  path={`/projetos/${project.slug}`}
>
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <a href={localizedPath(lang, 'projetos')} class="text-sm font-medium text-[var(--color-petrol-600)] underline-grow dark:text-[var(--color-petrol-300)]">
      ← {t('projects.back')}
    </a>

    <Kicker class="mt-6">{project.categoryLabel?.pt ?? (project.category === 'research' ? 'Pesquisa e tecnologia' : 'Empreendedorismo')}</Kicker>
    <h1 class="mt-2 font-serif-display text-3xl font-semibold text-[var(--color-ink)] sm:text-4xl dark:text-[var(--color-ink-dark)]">
      {project.title.pt}
    </h1>
    <p class="mt-2 text-lg text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.subtitle.pt}</p>

    {project.diagram && diagramMap[project.diagram] && (
      project.diagram === 'lia-avatar.webp' ? (
        <div class="mt-8 w-40 overflow-hidden rounded-2xl border border-[var(--color-line)] shadow-sm dark:border-[var(--color-line-dark)]">
          <Image src={diagramMap[project.diagram]} alt={project.title.pt} width={240} class="w-full object-cover" />
        </div>
      ) : (
        <div class="mt-8 overflow-hidden rounded-2xl border border-[var(--color-line)] dark:border-[var(--color-line-dark)]">
          <Image src={diagramMap[project.diagram]} alt={project.title.pt} width={1100} class="w-full bg-white" />
        </div>
      )
    )}

    <div class="prose-measure mt-8 space-y-6 text-[0.98rem] leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
      <p>{project.overview.pt}</p>
    </div>

    {sections.map((s) => (
      <section class="mt-10">
        <h2 class="font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">{s.heading}</h2>
        <p class="prose-measure mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{s.body}</p>
      </section>
    ))}

    <section class="mt-10 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper-dim)] p-6 dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark-dim)]">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">
        {t('projects.role')}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">{project.contribution.pt}</p>
    </section>

    {project.results && (
      <section class="mt-10">
        <h2 class="font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
          {lang === 'pt' ? 'Resultados e validação' : 'Results and validation'}
        </h2>
        <p class="prose-measure mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.results.pt}</p>
      </section>
    )}

    {project.relevance && (
      <section class="mt-10">
        <h2 class="font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
          {lang === 'pt' ? 'Relevância' : 'Relevance'}
        </h2>
        <p class="prose-measure mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.relevance.pt}</p>
      </section>
    )}

    {project.caution && (
      <p class="mt-8 rounded-xl border border-dashed border-[var(--color-line)] px-4 py-3 text-xs leading-relaxed text-[var(--color-ink-soft)] dark:border-[var(--color-line-dark)] dark:text-[var(--color-ink-dark-soft)]">
        {project.caution.pt}
      </p>
    )}

    {project.tech.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">
          {t('projects.tech')}
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {project.tech.map((item) => (
            <span class="rounded-full border border-[var(--color-line)] px-3 py-1 text-xs font-medium text-[var(--color-ink-soft)] dark:border-[var(--color-line-dark)] dark:text-[var(--color-ink-dark-soft)]">
              {item}
            </span>
          ))}
        </div>
      </div>
    )}

    {project.links && project.links.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-4 border-t border-[var(--color-line)] pt-8 dark:border-[var(--color-line-dark)]">
        {project.links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-sm font-medium text-[var(--color-petrol-600)] underline-grow dark:text-[var(--color-petrol-300)]"
          >
            {link.label.pt} ↗
          </a>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
