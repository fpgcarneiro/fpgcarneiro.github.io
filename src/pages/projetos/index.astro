---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations } from '../../i18n/utils';
import { projects } from '../../data/projects';

const lang = 'pt' as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title="Projetos"
  description="Portfólio de projetos de pesquisa aplicada e desenvolvimento de IA de Fernanda Guidotti Carneiro: Arquitetura 6C, SmartProd, VITA e mais."
  path="/projetos"
>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <Kicker>{t('projects.kicker')}</Kicker>
    <h1 class="mt-3 font-serif-display text-3xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
      {t('projects.title')}
    </h1>
    <p class="prose-measure mt-4 text-base leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
      {t('projects.intro')}
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>
</BaseLayout>
