---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/Kicker.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { useTranslations } from '../i18n/utils';
import { experience } from '../data/experience';

const lang = 'pt' as const;
const t = useTranslations(lang);

const sorted = [...experience].sort((a, b) => (a.start < b.start ? 1 : -1));
---

<BaseLayout
  lang={lang}
  title="Experiência"
  description="Linha do tempo profissional de Fernanda Guidotti Carneiro: docência, pesquisa em PD&I no SENAI e atuação na MaximizaIA."
  path="/experiencia"
>
  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <Kicker>{t('experience.kicker')}</Kicker>
    <h1 class="mt-3 font-serif-display text-3xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
      {t('experience.title')}
    </h1>
    <p class="prose-measure mt-4 text-base leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
      {t('experience.intro')}
    </p>

    <div class="mt-12 space-y-10">
      {sorted.map((entry, i) => (
        <TimelineItem entry={entry} lang={lang} isLast={i === sorted.length - 1} />
      ))}
    </div>
  </section>
</BaseLayout>
