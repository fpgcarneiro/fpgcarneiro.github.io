---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
import { useTranslations, navPath } from '../../i18n/utils';
import { publications, theses } from '../../data/research';
import headshot from '../../assets/photos/source/fernanda-headshot.webp';

const lang = 'en' as const;
const t = useTranslations(lang);

const areas = [
  'Industrial Artificial Intelligence',
  'AI systems architecture',
  'MLOps and model governance',
  'Predictive maintenance',
  'Demand forecasting and optimization',
  'Applied generative AI and LLMs',
];

const latest = publications.slice(0, 2);
const thesis = theses.find((t2) => t2.slug === 'arquitetura-6c')!;
---

<BaseLayout
  lang={lang}
  title="Home"
  description="Fernanda Guidotti Carneiro — PhD in Computer Science, Industrial AI researcher, and author of the 6C Architecture."
  path="/en"
>
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-28">
    <div>
      <Kicker>{t('home.kicker')}</Kicker>
      <h1 class="mt-4 font-serif-display text-3xl font-semibold leading-tight text-[var(--color-ink)] sm:text-4xl lg:text-[2.75rem] dark:text-[var(--color-ink-dark)]">
        {t('home.headline')}
      </h1>
      <p class="prose-measure mt-6 text-base leading-relaxed text-[var(--color-ink-soft)] sm:text-lg dark:text-[var(--color-ink-dark-soft)]">
        {t('home.intro')}
      </p>

      <blockquote class="prose-measure mt-8 border-l-2 border-[var(--color-petrol-500)] pl-6">
        <p class="font-serif-display text-lg italic leading-relaxed text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
          “{t('home.quote')}”
        </p>
        <footer class="mt-3 text-sm not-italic text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
          — Fernanda Guidotti Carneiro
        </footer>
      </blockquote>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={navPath(lang, 'pesquisa')}
          class="rounded-full bg-[var(--color-petrol-600)] px-6 py-3 text-sm font-medium text-white transition hover:bg-[var(--color-petrol-700)]"
        >
          {t('home.cta.research')}
        </a>
        <a
          href={navPath(lang, 'projetos')}
          class="rounded-full border border-[var(--color-line)] px-6 py-3 text-sm font-medium text-[var(--color-ink)] transition hover:border-[var(--color-petrol-500)] hover:text-[var(--color-petrol-600)] dark:border-[var(--color-line-dark)] dark:text-[var(--color-ink-dark)]"
        >
          {t('home.cta.projects')}
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xs lg:max-w-sm">
      <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-[var(--color-petrol-50)] dark:bg-[var(--color-petrol-900)]"></div>
      <Image
        src={headshot}
        alt="Portrait of Fernanda Guidotti Carneiro"
        width={480}
        height={600}
        class="aspect-[4/5] w-full rounded-[1.75rem] object-cover shadow-[0_20px_60px_-20px_rgba(22,63,66,0.35)]"
      />
    </div>
  </section>

  <section class="border-y border-[var(--color-line)] bg-[var(--color-paper-dim)] dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark-dim)]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <Kicker>{t('home.areas.title')}</Kicker>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {areas.map((area) => (
          <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] px-5 py-4 text-sm font-medium text-[var(--color-ink)] dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark)] dark:text-[var(--color-ink-dark)]">
            {area}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-line)] bg-[var(--color-petrol-900)] dark:border-[var(--color-line-dark)]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-petrol-300)]">{t('home.results.kicker')}</p>
      <h2 class="mt-3 font-serif-display text-2xl font-semibold text-white">{t('home.results.title')}</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div>
          <p class="font-serif-display text-5xl font-semibold text-white">{t('home.results.stat1.value')}</p>
          <p class="mt-2 text-sm text-[var(--color-petrol-100)]">{t('home.results.stat1.label')}</p>
        </div>
        <div>
          <p class="font-serif-display text-5xl font-semibold text-white">{t('home.results.stat2.value')}</p>
          <p class="mt-2 text-sm text-[var(--color-petrol-100)]">{t('home.results.stat2.label')}</p>
        </div>
      </div>
      <p class="mt-6 max-w-xl text-xs leading-relaxed text-[var(--color-petrol-100)]/80">{t('home.results.sub')}</p>
      <a
        href={`${navPath(lang, 'projetos')}/smartprod`}
        class="mt-6 inline-block text-sm font-medium text-white underline-grow"
      >
        {t('home.results.cta')} →
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <Kicker>{t('home.featured.title')}</Kicker>
    <p class="mt-2 max-w-xl text-sm text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{t('home.featured.sub')}</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_1fr]">
      <a
        href={navPath(lang, 'arquitetura-6c')}
        class="group flex flex-col justify-between rounded-2xl border border-[var(--color-petrol-500)]/30 bg-[var(--color-petrol-50)] p-7 transition hover:border-[var(--color-petrol-500)] dark:border-[var(--color-petrol-700)] dark:bg-[var(--color-petrol-900)]/40"
      >
        <div>
          <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">
            PhD thesis
          </span>
          <h3 class="mt-2 font-serif-display text-2xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
            {thesis.title.en}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
            {thesis.summary.en}
          </p>
        </div>
        <span class="mt-6 text-sm font-medium text-[var(--color-petrol-600)] underline-grow dark:text-[var(--color-petrol-300)]">
          Explore the 6C Architecture →
        </span>
      </a>

      <div class="flex flex-col gap-4">
        {latest.map((pub) => (
          <a
            href={navPath(lang, 'pesquisa')}
            class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6 transition hover:border-[var(--color-petrol-500)] dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark-dim)]"
          >
            <span class="text-xs font-semibold text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">{pub.year} · {pub.venue}</span>
            <h4 class="mt-1 font-serif-display text-base font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
              {pub.title.en}
            </h4>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
