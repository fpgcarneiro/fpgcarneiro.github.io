---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Kicker from '../../../components/Kicker.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { useTranslations } from '../../../i18n/utils';
import { projects } from '../../../data/projects';

const lang = 'en' as const;
const t = useTranslations(lang);

const research = projects.filter((p) => p.category === 'research');
const ventures = projects.filter((p) => p.category === 'venture');
---

<BaseLayout
  lang={lang}
  title="Projects"
  description="Portfolio of applied research and AI development projects by Fernanda Guidotti Carneiro: 6C Architecture, SmartProd, VITA, and more."
  path="/en/projects"
>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <Kicker>{t('projects.kicker')}</Kicker>
    <h1 class="mt-3 font-serif-display text-3xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
      {t('projects.title')}
    </h1>
    <p class="prose-measure mt-4 text-base leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
      {t('projects.intro')}
    </p>

    <div class="mt-14">
      <h2 class="font-serif-display text-xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
        Research and technology
      </h2>
      <p class="mt-1 text-sm text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
        AI architecture, intelligent industrial systems, and optimization, developed in research and in industry.
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {research.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </div>

    <div class="mt-16">
      <h2 class="font-serif-display text-xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
        Entrepreneurship and ventures
      </h2>
      <p class="mt-1 text-sm text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
        Personal ventures, outside the scope of industrial research.
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {ventures.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
