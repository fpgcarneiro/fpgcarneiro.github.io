---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Kicker from '../../../components/Kicker.astro';
import { useTranslations, navPath } from '../../../i18n/utils';
import { projects } from '../../../data/projects';
import overview from '../../../assets/diagrams/6c-overview.png';
import caseSmartprod from '../../../assets/diagrams/case-smartprod.png';
import vitaLogo from '../../../assets/diagrams/vita-logo.webp';
import liaAvatar from '../../../assets/diagrams/lia-avatar.webp';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const diagramMap: Record<string, ImageMetadata> = {
  '6c-overview.png': overview,
  'case-smartprod.png': caseSmartprod,
  'vita-logo.webp': vitaLogo,
  'lia-avatar.webp': liaAvatar,
};

const { project } = Astro.props;
const lang = 'en' as const;
const t = useTranslations(lang);

// internal links are authored as pt paths (e.g. "/arquitetura-6c"); translate to the en equivalent
function resolveHref(href: string) {
  if (href.startsWith('http')) return href;
  const ptSlug = href.replace(/^\//, '');
  return navPath(lang, ptSlug);
}

const sections: { heading: string; body: string }[] = [
  project.challenge && { heading: 'The challenge', body: project.challenge.en },
  project.solution && { heading: 'The solution', body: project.solution.en },
  project.methodology && { heading: 'Methodology', body: project.methodology.en },
  project.architecture && { heading: 'Architecture', body: project.architecture.en },
  ...(project.extraSections ?? []).map((s) => ({ heading: s.heading.en, body: s.body.en })),
].filter(Boolean) as { heading: string; body: string }[];
---

<BaseLayout
  lang={lang}
  title={project.title.en}
  description={project.subtitle.en}
  path={`/en/projects/${project.slug}`}
>
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <a href={navPath(lang, 'projetos')} class="text-sm font-medium text-[var(--color-petrol-600)] underline-grow dark:text-[var(--color-petrol-300)]">
      ← {t('projects.back')}
    </a>

    <Kicker class="mt-6">{project.categoryLabel?.en ?? (project.category === 'research' ? 'Research and technology' : 'Entrepreneurship')}</Kicker>
    <h1 class="mt-2 font-serif-display text-3xl font-semibold text-[var(--color-ink)] sm:text-4xl dark:text-[var(--color-ink-dark)]">
      {project.title.en}
    </h1>
    {project.diagram === 'lia-avatar.webp' && diagramMap[project.diagram] ? (
      <div class="mt-6 flex items-center gap-6">
        <div class="w-28 shrink-0 overflow-hidden rounded-2xl border border-[var(--color-line)] shadow-sm dark:border-[var(--color-line-dark)]">
          <Image src={diagramMap[project.diagram]} alt={project.title.en} width={200} class="w-full object-cover" />
        </div>
        <p class="text-lg text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.subtitle.en}</p>
      </div>
    ) : (
      <>
        <p class="mt-2 text-lg text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.subtitle.en}</p>
        {project.diagram && diagramMap[project.diagram] && (
          <div class="mt-8 overflow-hidden rounded-2xl border border-[var(--color-line)] dark:border-[var(--color-line-dark)]">
            <Image src={diagramMap[project.diagram]} alt={project.title.en} width={1100} class="w-full bg-white" />
          </div>
        )}
      </>
    )}

    <div class="prose-measure mt-8 space-y-6 text-[0.98rem] leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
      <p>{project.overview.en}</p>
    </div>

    {sections.map((s) => (
      <section class="mt-10">
        <h2 class="font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">{s.heading}</h2>
        <p class="prose-measure mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{s.body}</p>
      </section>
    ))}

    <section class="mt-10 rounded-2xl border border-[var(--color-line)] bg-[var(--color-paper-dim)] p-6 dark:border-[var(--color-line-dark)] dark:bg-[var(--color-paper-dark-dim)]">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">
        {t('projects.role')}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">{project.contribution.en}</p>
    </section>

    {project.results && (
      <section class="mt-10">
        <h2 class="font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">Results and validation</h2>
        <p class="prose-measure mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.results.en}</p>
      </section>
    )}

    {project.relevance && (
      <section class="mt-10">
        <h2 class="font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">Relevance</h2>
        <p class="prose-measure mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{project.relevance.en}</p>
      </section>
    )}

    {project.caution && (
      <p class="mt-8 rounded-xl border border-dashed border-[var(--color-line)] px-4 py-3 text-xs leading-relaxed text-[var(--color-ink-soft)] dark:border-[var(--color-line-dark)] dark:text-[var(--color-ink-dark-soft)]">
        {project.caution.en}
      </p>
    )}

    {project.tech.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">{t('projects.tech')}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {project.tech.map((item) => (
            <span class="rounded-full border border-[var(--color-line)] px-3 py-1 text-xs font-medium text-[var(--color-ink-soft)] dark:border-[var(--color-line-dark)] dark:text-[var(--color-ink-dark-soft)]">
              {item}
            </span>
          ))}
        </div>
      </div>
    )}

    {project.links && project.links.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-4 border-t border-[var(--color-line)] pt-8 dark:border-[var(--color-line-dark)]">
        {project.links.map((link) => (
          <a
            href={resolveHref(link.href)}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-sm font-medium text-[var(--color-petrol-600)] underline-grow dark:text-[var(--color-petrol-300)]"
          >
            {link.label.en} ↗
          </a>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
