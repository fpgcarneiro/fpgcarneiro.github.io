---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/Kicker.astro';
import { useTranslations } from '../i18n/utils';
import { speaking } from '../data/speaking';
import enegepPhoto from '../assets/photos/source/fernanda-speaking-enegep-2026.jpg';
import mulheresPhoto from '../assets/photos/source/fernanda-mulheres-empreendedoras-stage.jpg';
import ifrsPhoto from '../assets/photos/source/fernanda-ifrs-presenting.jpg';
import debaPhoto from '../assets/photos/source/fernanda-deba-vdi-2024.jpg';

const lang = 'pt' as const;
const t = useTranslations(lang);

const images: Record<string, ImageMetadata> = {
  'fernanda-speaking-enegep-2026.jpg': enegepPhoto,
  'fernanda-mulheres-empreendedoras-stage.jpg': mulheresPhoto,
  'fernanda-deba-vdi-2024.jpg': debaPhoto,
  'fernanda-ifrs-presenting.jpg': ifrsPhoto,
};
---

<BaseLayout
  lang={lang}
  title="Palestras"
  description="Participações de Fernanda Guidotti Carneiro em congressos científicos e eventos de Engenharia de Produção e Inteligência Artificial."
  path="/palestras"
>
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <Kicker>{t('speaking.kicker')}</Kicker>
    <h1 class="mt-3 font-serif-display text-3xl font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
      {t('speaking.title')}
    </h1>
    <p class="prose-measure mt-4 text-base leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
      {t('speaking.intro')}
    </p>

    <div class="mt-12 space-y-12">
      {[...speaking].sort((a, b) => b.date.localeCompare(a.date)).map((entry) => (
        <article class="grid gap-6 sm:grid-cols-[1.1fr_0.9fr] sm:items-center">
          {entry.image && (
            <div class="overflow-hidden rounded-2xl border border-[var(--color-line)] dark:border-[var(--color-line-dark)]">
              <Image src={images[entry.image]} alt={entry.title[lang]} width={700} class="w-full object-cover" />
            </div>
          )}
          <div>
            <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-petrol-600)] dark:text-[var(--color-petrol-300)]">
              {entry.event}
            </span>
            <h2 class="mt-2 font-serif-display text-lg font-semibold text-[var(--color-ink)] dark:text-[var(--color-ink-dark)]">
              {entry.title[lang]}
            </h2>
            <p class="mt-1 text-sm text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">{entry.location}</p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-ink-dark-soft)]">
              {entry.description[lang]}
            </p>
            {entry.link && (
              <a href={entry.link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-sm font-medium text-[var(--color-petrol-600)] underline-grow dark:text-[var(--color-petrol-300)]">
                {lang === 'pt' ? 'Saiba mais' : 'Learn more'} ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
